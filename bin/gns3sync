    elif platform_type == "vyos":
        cmt = "#"
        header_lines = "\n".join([f"{cmt} {line}" if line else cmt for line in header_text.splitlines()])
        snippet = (
            f"{cmt} =====================================================================\n"
            f"{cmt} {header_lines}\n"
            f"{cmt} =====================================================================\n"
            f"{clean_content.strip()}\n"
        )
        return "text", snippet

    elif platform_type == "vpcs":
        return "text", clean_content.strip()
    elif platform_type == "docker":
        cmt = "#"
        header_lines = "\n".join([f"{cmt} {line}" if line else cmt for line in header_text.splitlines()])
        snippet = (
            f"{cmt} =====================================================================\n"
            f"{cmt} {header_lines}\n"
