        snippet = (
            f"{cmt} =====================================================================\n"
            f"{header_lines}\n"
            f"{cmt} =====================================================================\n"
            f"sudo tee {path} > /dev/null << 'EOF'\n"
            f"{clean_content.strip()}\n"
            f"EOF\n"
        )
        return "bash", snippet

def inspect_generic_qemu_disk(qcow2_path, node_name, project_name):
    if not os.path.isfile(qcow2_path):
        return []
    try:
        if subprocess.run(["fuser", qcow2_path], capture_output=True).returncode == 0:
            return []
    except Exception:
        pass
    os.makedirs(MOUNT_POINT, exist_ok=True)
    extracted_list = []
    try:
        subprocess.run(["sudo", "qemu-nbd", "-d", NBD_DEV], capture_output=True)
        cmd_connect = [
            "sudo", "qemu-nbd", "-r", "-c", NBD_DEV,
            "--image-opts",
            f"driver=qcow2,file.filename={qcow2_path},file.locking=off,backing.file.locking=off"
        ]
        res = subprocess.run(cmd_connect, capture_output=True, text=True, timeout=5)
        if res.returncode != 0:
            return []
            
        time.sleep(0.4)
        subprocess.run(["sudo", "partx", "-u", NBD_DEV], capture_output=True)
        parts = sorted(glob.glob(f"{NBD_DEV}p*"), key=lambda p: os.path.basename(p))
        candidates = parts if parts else [NBD_DEV]
        
        for p in candidates:
            mounted = False
            for m_opt in [["-o", "ro,noload", "-t", "ext4"], ["-o", "ro"], ["-o", "ro"]]:
                m_res = subprocess.run(["sudo", "mount"] + m_opt + [p, MOUNT_POINT], capture_output=True)
                if m_res.returncode == 0:
                    mounted = True
                    break
            if not mounted:
                continue
                
            try:
                # 1. FRR Routing (OSPF, BGP, RIP, interfaces)
                frr_conf = os.path.join(MOUNT_POINT, "etc", "frr", "frr.conf")
                if os.path.isfile(frr_conf) or subprocess.run(["sudo", "test", "-f", frr_conf]).returncode == 0:
                    c_frr = safe_read_file(frr_conf)
                    if c_frr and any(k in c_frr for k in ["router ", "interface ", "frr ", "vtysh"]):
                        r_lang, r_snip = build_pasteable_snippet("frr", node_name, project_name, c_frr, target_path="/etc/frr/frr.conf")
                        extracted_list.append({
                            "type": "frr",
                            "filename": f"{node_name}_frr.conf",
                            "raw": c_frr,
                            "desc": "FRR Routing Config (OSPF/BGP/vtysh)",
                            "service_title": "FRR Routing (OSPF/BGP)",
                            "target_path": "/etc/frr/frr.conf",
                            "restore_lang": r_lang,
                            "restore_snippet": r_snip
                        })

                # 1b. FRR Daemons
                frr_daemons = os.path.join(MOUNT_POINT, "etc", "frr", "daemons")
                if os.path.isfile(frr_daemons) or subprocess.run(["sudo", "test", "-f", frr_daemons]).returncode == 0:
                    c_daemons = safe_read_file(frr_daemons)
                    if c_daemons and any(k in c_daemons for k in ["ospfd=yes", "bgpd=yes", "ripd=yes", "ospf6d=yes"]):
                        r_lang, r_snip = build_pasteable_snippet("frr_daemons", node_name, project_name, c_daemons, target_path="/etc/frr/daemons")
                        extracted_list.append({
                            "type": "frr_daemons",
                            "filename": f"{node_name}_frr_daemons",
                            "raw": c_daemons,
                            "desc": "FRR Active Daemons",
                            "service_title": "FRR Active Daemons",
                            "target_path": "/etc/frr/daemons",
                            "restore_lang": r_lang,
                            "restore_snippet": r_snip
                        })

                # 2. Linux Interfaces (/etc/network/interfaces)
                net_if = os.path.join(MOUNT_POINT, "etc", "network", "interfaces")
