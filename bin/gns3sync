try:
    import yaml
except ImportError:
    yaml = None


def get_web_url_from_git_remote(remote_url):
    """Converts SSH or HTTPS git remote URL to browser-accessible web URL."""
    if not remote_url:
        return ""
    url = remote_url.strip()
    if url.startswith("git@github.com:"):
        url = "https://github.com/" + url[len("git@github.com:"):]
    elif url.startswith("git@gitlab.com:"):
        url = "https://gitlab.com/" + url[len("git@gitlab.com:"):]
    elif url.startswith("https://") or url.startswith("http://"):
        pass
    elif ":" in url and "@" in url:
        parts = url.split(":", 1)
        host = parts[0].split("@", 1)[-1]
        url = f"https://{host}/{parts[1]}"
    if url.endswith(".git"):
        url = url[:-4]
    return url.rstrip("/")

def auto_detect_projects_dir():
    candidates = [
        os.path.expanduser("~/GNS3/projects"),
        "/opt/gns3/projects",
        "/var/lib/gns3/projects",
        "/mnt/gns3-fast/projects",
        os.path.expanduser("~/gns3/projects"),
    ]
    for c in candidates:
        if os.path.isdir(c):
            return c
    return os.path.expanduser("~/GNS3/projects")

DEFAULT_CONFIG = {
    "projects_dir": auto_detect_projects_dir(),
    "export_dir": os.path.expanduser("~/gns3-export/primary"),
    "personal_export_dir": os.path.expanduser("~/gns3-export/personal"),
    "repo_url": "",
    "personal_repo_url": "",
    "repo_name": "gns3-topology",
    "project_keywords": ["routing_switching", "grupparbete", "gns3sync", "primary", "main"],
    "mount_point": "/mnt/gns3_inspect",
    "nbd_dev": "/dev/nbd0",
    "auto_push": True
}

def load_config(custom_path=None):
    candidates = [
        custom_path,
        os.environ.get("GNS3SYNC_CONFIG"),
        "./config.yaml",
        "./gns3sync.yaml",
        os.path.expanduser("~/.config/gns3sync/config.yaml"),
        "/etc/gns3sync/config.yaml"
    ]
    cfg = dict(DEFAULT_CONFIG)
    for c in candidates:
        if c and os.path.isfile(c):
            if yaml:
                try:
                    with open(c, "r", encoding="utf-8") as f:
                        user_cfg = yaml.safe_load(f) or {}
                    cfg.update(user_cfg)
                    cfg["_loaded_from"] = c
                    break
                except Exception:
                    pass
            else:
                # Basic line parser if pyyaml missing
                try:
                    with open(c, "r", encoding="utf-8") as f:
                        for line in f:
                            if ":" in line and not line.strip().startswith("#"):
                                k, v = line.split(":", 1)
                                k = k.strip()
                                v = v.strip().strip('"').strip("'")
                                if v.lower() == "true": v = True
                                elif v.lower() == "false": v = False
                                cfg[k] = v
                    cfg["_loaded_from"] = c
                    break
                except Exception:
                    pass
    
    # Auto-detect projects_dir if default does not exist on disk
    if not os.path.isdir(cfg["projects_dir"]):
        for alt in ["/opt/gns3/projects", "/var/lib/gns3/projects", os.path.expanduser("~/GNS3/projects")]:
            if os.path.isdir(alt):
                cfg["projects_dir"] = alt
                break
    return cfg

# Active configuration instance
CONFIG = load_config()

BASE_EXPORT_DIR = os.path.dirname(CONFIG["export_dir"])
GROUP_EXPORT_DIR = CONFIG["export_dir"]
PERSONAL_EXPORT_DIR = CONFIG.get("personal_export_dir", os.path.join(BASE_EXPORT_DIR, "personal"))
PROJECTS_DIR = CONFIG["projects_dir"]
MOUNT_POINT = CONFIG["mount_point"]
NBD_DEV = CONFIG["nbd_dev"]
GROUP_PROJECT_KEYWORDS = CONFIG.get("project_keywords", ["routing_switching", "grupparbete", "gns3sync"])
def sanitize_name(name):
    clean = re.sub(r'[^a-zA-Z0-9åäöÅÄÖ\-_]+', '_', str(name))
    return clean.strip('_')

def escape_mermaid(text):
    return str(text).replace('"', "'").replace("<", "&lt;").replace(">", "&gt;")

def is_group_project(pname):
    return any(k in pname.lower() for k in GROUP_PROJECT_KEYWORDS)

def safe_read_file(filepath):
    try:
        with open(filepath, "r", errors="ignore") as f:
            return f.read().replace('\x00', '').strip()
    except Exception:
        try:
            res = subprocess.run(["sudo", "/usr/bin/cat", filepath], capture_output=True, text=True, errors="ignore")
            return res.stdout.replace('\x00', '').strip()
        except Exception:
            return ""

def extract_cisco_config(qcow2_path):
    if not os.path.isfile(qcow2_path) or os.path.getsize(qcow2_path) > 250 * 1024 * 1024:
        return None
    try:
        res = subprocess.run(["strings", "-a", "-n", "4", qcow2_path], capture_output=True, text=True, errors="replace", timeout=5)
        lines = res.stdout.splitlines()
        start = None
        for i, l in enumerate(lines):
            l_str = l.strip()
            if any(l_str.startswith(k) for k in ["version 15.", "version 12.", "version 16.", "version 17.", "hostname ", "Current configuration", "! Command: show running-config", "! vEOS version", "transceiver qsfp"]):
                start = i
                for k in range(max(0, i-5), i):
                    if lines[k].startswith("!"):
                        start = k
                        break
                break
        if start is None:
            return None
        cfg = []
        in_vty = False
        for l in lines[start:]:
            if re.match(r"^[0-9A-Fa-f]{2,8}\s+[0-9A-Fa-f]{8}", l) or (len(l.strip()) > 3 and all(c in "0123456789ABCDEFabcdef " for c in l.strip())):
                break
            if l.strip() == "end":
                cfg.append("end")
                break
            cfg.append(l)
            if l.startswith("line vty"):
                in_vty = True
            elif in_vty:
                if l.startswith("!") or l.strip() == "end" or len(l) > 60:
                    break
        if len(cfg) > 10:
            if not any(x.strip() == "end" for x in cfg[-3:]):
                cfg.append("!")
                cfg.append("end")
            raw = "\n".join(cfg)
            cleaned = re.sub(r'banner (?:exec|incoming|login|motd)[^\n]*\n(?:\*[^\n]*\n)+', '', raw)
            cleaned = cleaned.replace('\x00', '')
            cleaned = re.sub(r'\n{3,}', '\n\n', cleaned).strip()
            return cleaned
    except Exception:
        pass
    return None

def strip_config_header(text):
    """Strips auto-generated comment headers for accurate semantic diffing."""
    if not text:
        return ""
    lines = text.splitlines()
    if lines and ("===" in lines[0] or (len(lines) > 1 and "===" in lines[1])):
        idx = 0
        for i, l in enumerate(lines[:12]):
            if "===" in l and i > 0:
                idx = i + 1
                break
        return "\n".join(lines[idx:]).strip()
    return text.strip()

def get_previous_config(repo_dir, rel_path, current_content):
    """
    Finds the immediately preceding distinct version of rel_path in git history.
    Returns dict with commit hash, date, commit message, and raw content, or None.
    """
    if not repo_dir or not os.path.isdir(os.path.join(repo_dir, ".git")):
        return None
    res = subprocess.run(
        ["git", "-C", repo_dir, "log", "--format=%H|%cd|%s", "--date=iso", "--", rel_path],
        capture_output=True,
        text=True
    )
    if res.returncode != 0 or not res.stdout.strip():
        return None

    clean_cur = strip_config_header(current_content)
    for line in res.stdout.strip().splitlines():
        parts = line.split("|", 2)
        if len(parts) >= 3:
            h, d, msg = parts[0], parts[1], parts[2]
            show_res = subprocess.run(
                ["git", "-C", repo_dir, "show", f"{h}:{rel_path}"],
                capture_output=True,
                text=True
            )
            if show_res.returncode == 0:
                past_raw = show_res.stdout
                clean_past = strip_config_header(past_raw)
                if clean_past and clean_past != clean_cur:
                    return {
                        "commit": h[:7],
                        "date": d[:19],
                        "msg": msg,
                        "raw": past_raw
                    }
    return None

def build_pasteable_snippet(platform_type, node_name, project_name, content, is_rollback=False, commit_hash=None, commit_date=None, target_path=None):
    clean_content = strip_config_header(content)
    
    if is_rollback:
        header_text = (
            f"Rollback Configuration for {node_name} (1 Step Back)\n"
            f"Restores state from Git commit: {commit_hash} ({commit_date})\n"
            f"Paste directly into terminal/console to restore previous configuration."
        )
    else:
        header_text = (
            f"Active Disaster Recovery for {node_name} ({project_name})\n"
            f"Paste directly into terminal/console to reapply active configuration."
        )

    if platform_type in ["cisco", "arista"]:
        cfg_clean = clean_content.strip()
        if not cfg_clean.endswith("end"):
            cfg_clean += "\nend"
        cmt = "!"
        header_lines = "\n".join([f"{cmt} {line}" if line else cmt for line in header_text.splitlines()])
        snippet = (
            f"{cmt} =====================================================================\n"
            f"{header_lines}\n"
            f"{cmt} =====================================================================\n"
            f"enable\n"
            f"configure terminal\n"
            f"{cfg_clean}\n"
            f"write memory\n"
        )
        return "cisco", snippet

    elif platform_type in ["linux_interfaces", "interfaces"]:
        path = target_path or "/etc/network/interfaces"
        cmt = "#"
        header_lines = "\n".join([f"{cmt} {line}" if line else cmt for line in header_text.splitlines()])
        snippet = (
            f"{cmt} =====================================================================\n"
            f"{header_lines}\n"
            f"{cmt} =====================================================================\n"
            f"sudo tee {path} > /dev/null << 'EOF'\n"
            f"{clean_content.strip()}\n"
            f"EOF\n"
            f"sudo systemctl restart networking 2>/dev/null || sudo ifreload -a 2>/dev/null || sudo /etc/init.d/networking restart\n"
        )
        return "bash", snippet

    elif platform_type == "netplan":
        path = target_path or "/etc/netplan/01-netcfg.yaml"
        cmt = "#"
        header_lines = "\n".join([f"{cmt} {line}" if line else cmt for line in header_text.splitlines()])
        snippet = (
            f"{cmt} =====================================================================\n"
            f"{header_lines}\n"
            f"{cmt} =====================================================================\n"
            f"sudo tee {path} > /dev/null << 'EOF'\n"
            f"{clean_content.strip()}\n"
            f"EOF\n"
            f"sudo netplan apply\n"
        )
        return "bash", snippet

    elif platform_type == "frr":
        path = target_path or "/etc/frr/frr.conf"
        cmt = "#"
        header_lines = "\n".join([f"{cmt} {line}" if line else cmt for line in header_text.splitlines()])
        snippet = (
            f"{cmt} =====================================================================\n"
            f"{header_lines}\n"
            f"{cmt} =====================================================================\n"
            f"sudo tee {path} > /dev/null << 'EOF'\n"
            f"{clean_content.strip()}\n"
            f"EOF\n"
            f"sudo systemctl restart frr 2>/dev/null || sudo vtysh -f {path}\n"
        )
        return "bash", snippet

    elif platform_type == "frr_daemons":
        path = target_path or "/etc/frr/daemons"
        cmt = "#"
        header_lines = "\n".join([f"{cmt} {line}" if line else cmt for line in header_text.splitlines()])
        snippet = (
            f"{cmt} =====================================================================\n"
            f"{header_lines}\n"
            f"{cmt} =====================================================================\n"
            f"sudo tee {path} > /dev/null << 'EOF'\n"
            f"{clean_content.strip()}\n"
            f"EOF\n"
            f"sudo systemctl restart frr\n"
        )
        return "bash", snippet

    elif platform_type == "nginx":
        path = target_path or "/etc/nginx/sites-available/default"
        cmt = "#"
        header_lines = "\n".join([f"{cmt} {line}" if line else cmt for line in header_text.splitlines()])
        snippet = (
            f"{cmt} =====================================================================\n"
            f"{header_lines}\n"
            f"{cmt} =====================================================================\n"
            f"sudo tee {path} > /dev/null << 'EOF'\n"
            f"{clean_content.strip()}\n"
            f"EOF\n"
            f"sudo nginx -t && sudo systemctl reload nginx\n"
        )
        return "bash", snippet

    elif platform_type == "unbound":
        path = target_path or "/etc/unbound/unbound.conf.d/lab.conf"
        cmt = "#"
        header_lines = "\n".join([f"{cmt} {line}" if line else cmt for line in header_text.splitlines()])
        snippet = (
            f"{cmt} =====================================================================\n"
            f"{header_lines}\n"
            f"{cmt} =====================================================================\n"
            f"sudo tee {path} > /dev/null << 'EOF'\n"
            f"{clean_content.strip()}\n"
            f"EOF\n"
            f"sudo unbound-checkconf 2>/dev/null; sudo systemctl restart unbound\n"
        )
        return "bash", snippet

    elif platform_type == "bind":
        path = target_path or "/etc/bind/named.conf.local"
        cmt = "#"
        header_lines = "\n".join([f"{cmt} {line}" if line else cmt for line in header_text.splitlines()])
        snippet = (
            f"{cmt} =====================================================================\n"
            f"{header_lines}\n"
            f"{cmt} =====================================================================\n"
            f"sudo tee {path} > /dev/null << 'EOF'\n"
            f"{clean_content.strip()}\n"
            f"EOF\n"
            f"sudo named-checkconf 2>/dev/null; sudo systemctl restart bind9\n"
        )
        return "bash", snippet

    elif platform_type in ["snmptrapd", "snmpd"]:
        path = target_path or ("/etc/snmp/snmptrapd.conf" if platform_type == "snmptrapd" else "/etc/snmp/snmpd.conf")
        svc = "snmptrapd" if platform_type == "snmptrapd" else "snmpd"
        cmt = "#"
        header_lines = "\n".join([f"{cmt} {line}" if line else cmt for line in header_text.splitlines()])
        snippet = (
            f"{cmt} =====================================================================\n"
            f"{header_lines}\n"
            f"{cmt} =====================================================================\n"
            f"sudo tee {path} > /dev/null << 'EOF'\n"
            f"{clean_content.strip()}\n"
            f"EOF\n"
            f"sudo systemctl restart {svc}\n"
        )
        return "bash", snippet

    elif platform_type in ["nftables", "iptables", "ufw"]:
        path = target_path or ("/etc/nftables.conf" if platform_type == "nftables" else "/etc/iptables/rules.v4")
        apply_cmd = f"sudo nft -f {path}" if platform_type == "nftables" else ("sudo ufw reload" if platform_type == "ufw" else f"sudo iptables-restore < {path}")
        cmt = "#"
        header_lines = "\n".join([f"{cmt} {line}" if line else cmt for line in header_text.splitlines()])
        snippet = (
            f"{cmt} =====================================================================\n"
            f"{header_lines}\n"
            f"{cmt} =====================================================================\n"
            f"sudo tee {path} > /dev/null << 'EOF'\n"
            f"{clean_content.strip()}\n"
            f"EOF\n"
            f"{apply_cmd}\n"
        )
        return "bash", snippet

    elif platform_type == "wireguard":
        path = target_path or "/etc/wireguard/wg0.conf"
        base_if = os.path.splitext(os.path.basename(path))[0]
        cmt = "#"
        header_lines = "\n".join([f"{cmt} {line}" if line else cmt for line in header_text.splitlines()])
        snippet = (
            f"{cmt} =====================================================================\n"
            f"{header_lines}\n"
            f"{cmt} =====================================================================\n"
            f"sudo tee {path} > /dev/null << 'EOF'\n"
            f"{clean_content.strip()}\n"
            f"EOF\n"
            f"sudo systemctl restart wg-quick@{base_if}\n"
        )
        return "bash", snippet

    elif platform_type in ["keepalived", "haproxy"]:
        path = target_path or ("/etc/keepalived/keepalived.conf" if platform_type == "keepalived" else "/etc/haproxy/haproxy.conf")
        svc = "keepalived" if platform_type == "keepalived" else "haproxy"
        cmt = "#"
        header_lines = "\n".join([f"{cmt} {line}" if line else cmt for line in header_text.splitlines()])
        snippet = (
            f"{cmt} =====================================================================\n"
            f"{header_lines}\n"
            f"{cmt} =====================================================================\n"
            f"sudo tee {path} > /dev/null << 'EOF'\n"
            f"{clean_content.strip()}\n"
            f"EOF\n"
            f"sudo systemctl restart {svc}\n"
        )
        return "bash", snippet

    elif platform_type == "sysctl":
        path = target_path or "/etc/sysctl.d/99-ipforward.conf"
        cmt = "#"
        header_lines = "\n".join([f"{cmt} {line}" if line else cmt for line in header_text.splitlines()])
        snippet = (
            f"{cmt} =====================================================================\n"
            f"{header_lines}\n"
            f"{cmt} =====================================================================\n"
            f"sudo tee {path} > /dev/null << 'EOF'\n"
            f"{clean_content.strip()}\n"
            f"EOF\n"
            f"sudo sysctl --system\n"
        )
        return "bash", snippet

    elif platform_type == "junos":
        cmt = "#"
        header_lines = "\n".join([f"{cmt} {line}" if line else cmt for line in header_text.splitlines()])
        snippet = (
            f"{cmt} =====================================================================\n"
            f"{header_lines}\n"
            f"{cmt} Paste into Junos CLI (enter 'cli', then 'configure'):\n"
            f"{cmt} =====================================================================\n"
            f"load override terminal\n"
            f"{clean_content.strip()}\n"
            f"# (Press Ctrl+D, then execute:)\n"
            f"# commit and-quit\n"
        )
        return "text", snippet

    elif platform_type == "freebsd":
        cmt = "#"
        header_lines = "\n".join([f"{cmt} {line}" if line else cmt for line in header_text.splitlines()])
        snippet = (
            f"{cmt} =====================================================================\n"
            f"{cmt} {header_lines}\n"
